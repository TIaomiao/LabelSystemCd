  "components": {
    "schemas": {
      "ContourSet-Input": {
        "properties": {
          "series_id": {
            "type": "integer",
            "title": "Series Id"
          },
          "module": {
            "type": "string",
            "enum": [
              "function",
              "lge"
            ],
            "title": "Module"
          },
          "coordinate_space": {
            "type": "string",
            "const": "pixel",
            "title": "Coordinate Space",
            "default": "pixel"
          },
          "source": {
            "type": "string",
            "title": "Source",
            "default": "manual"
          },
          "settings": {
            "additionalProperties": true,
            "type": "object",
            "title": "Settings"
          },
          "phase_labels": {
            "$ref": "#/components/schemas/PhaseLabels"
          },
          "frames": {
            "additionalProperties": {
              "$ref": "#/components/schemas/FrameContour-Input"
            },
            "type": "object",
            "title": "Frames"
          }
        },
        "type": "object",
        "required": [
          "series_id",
          "module"
        ],
        "title": "ContourSet"
      },
      "ContourSet-Output": {
        "properties": {
          "series_id": {
            "type": "integer",
            "title": "Series Id"
          },
          "module": {
            "type": "string",
            "enum": [
              "function",
              "lge"
            ],
            "title": "Module"
          },
          "coordinate_space": {
            "type": "string",
            "const": "pixel",
            "title": "Coordinate Space",
            "default": "pixel"
          },
          "source": {
            "type": "string",
            "title": "Source",
            "default": "manual"
          },
          "settings": {
            "additionalProperties": true,
            "type": "object",
            "title": "Settings"
          },
          "phase_labels": {
            "$ref": "#/components/schemas/PhaseLabels"
          },
          "frames": {
            "additionalProperties": {
              "$ref": "#/components/schemas/FrameContour-Output"
            },
            "type": "object",
            "title": "Frames"
          }
        },
        "type": "object",
        "required": [
          "series_id",
          "module"
        ],
        "title": "ContourSet"
      },
      "DirectoryEntry": {
        "properties": {
          "name": {
            "type": "string",
            "title": "Name"
          },
          "path": {
            "type": "string",
            "title": "Path"
          },
          "has_dicom": {
            "type": "boolean",
            "title": "Has Dicom",
            "default": false
          }
        },
        "type": "object",
        "required": [
          "name",
          "path"
        ],
        "title": "DirectoryEntry"
      },
      "DirectoryListing": {
        "properties": {
          "current_path": {
            "type": "string",
            "title": "Current Path"
          },
          "parent_path": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Parent Path"
          },
          "directories": {
            "items": {
              "$ref": "#/components/schemas/DirectoryEntry"
            },
            "type": "array",
            "title": "Directories"
          },
          "default_sample_path": {
            "type": "string",
            "title": "Default Sample Path",
            "default": ""
          }
        },
        "type": "object",
        "required": [
          "current_path"
        ],
        "title": "DirectoryListing"
      },
      "FrameContour-Input": {
        "properties": {
          "include": {
            "type": "boolean",
            "title": "Include",
            "default": true
          },
          "endo": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/PolygonContour"
              },
              {
                "type": "null"
              }
            ]
          },
          "epi": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/PolygonContour"
              },
              {
                "type": "null"
              }
            ]
          },
          "rv": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/PolygonContour"
              },
              {
                "type": "null"
              }
            ]
          },
          "remote": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/PolygonContour"
              },
              {
                "type": "null"
              }
            ]
          },
          "enhanced": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/PolygonContour"
              },
              {
                "type": "null"
              }
            ]
          },
          "exclude": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/PolygonContour"
              },
              {
                "type": "null"
              }
            ]
          },
          "mvo": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/PolygonContour"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "type": "object",
        "title": "FrameContour"
      },
      "FrameContour-Output": {
        "properties": {
          "include": {
            "type": "boolean",
            "title": "Include",
            "default": true
          },
          "endo": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/PolygonContour"
              },
              {
                "type": "null"
              }
            ]
          },
          "epi": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/PolygonContour"
              },
              {
                "type": "null"
              }
            ]
          },
          "rv": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/PolygonContour"
              },
              {
                "type": "null"
              }
            ]
          },
          "remote": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/PolygonContour"
              },
              {
                "type": "null"
              }
            ]
          },
          "enhanced": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/PolygonContour"
              },
              {
                "type": "null"
              }
            ]
          },
          "exclude": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/PolygonContour"
              },
              {
                "type": "null"
              }
            ]
          },
          "mvo": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/PolygonContour"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "type": "object",
        "title": "FrameContour"
      },
      "FrameRef": {
        "properties": {
          "id": {
            "type": "integer",
            "title": "Id"
          },
          "slice_index": {
            "type": "integer",
            "title": "Slice Index"
          },
          "phase_index": {
            "type": "integer",
            "title": "Phase Index"
          },
          "instance_number": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
