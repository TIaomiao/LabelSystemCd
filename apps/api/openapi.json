            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      },
      "put": {
        "summary": "Put Contours",
        "operationId": "put_contours_contours__series_id__put",
        "parameters": [
          {
            "name": "series_id",
            "in": "path",
